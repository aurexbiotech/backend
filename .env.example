# ==========================================
# AUREX HMS Backend Configuration Example
# ==========================================

# MySQL Database connection URL format:
# mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/aurex

# Cryptographic secret keys (generate random strings with at least 32 characters)
APP_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
CSRF_SECRET_KEY=change-this-to-a-secure-csrf-secret-key-at-least-32-chars

# Allowed frontend origins for CORS (comma-separated)
FRONTEND_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# Cookie security (set to true in production behind HTTPS)
COOKIE_SECURE=false

# Session expiration time in hours
SESSION_TTL_HOURS=8
